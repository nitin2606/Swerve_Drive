<?xml version="1.0" ?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find swerve_drive_description)/urdf/materials.xacro" />
<!-- <xacro:include filename="$(find swerve_drive_description)/urdf/swerve.trans" /> -->
<!-- <xacro:include filename="$(find swerve_drive_description)/urdf/swerve.gazebo" /> -->


<xacro:arg name="namespace" default=""/>
<!-- Chassis dimensions -->
<xacro:property name="chassis_mass" value="1.0" /> <!-- arbitrary value for base mass -->
<xacro:property name="chassis_length" value="0.85" />
<xacro:property name="chassis_width" value="0.75" />
<xacro:property name="chassis_height" value="0.06" />

<!-- Suspension dimensions -->
<xacro:property name="wheel_offset" value="0.01" />
<xacro:property name="steering_mass" value="0.2" />
<xacro:property name="steering_radius" value="0.05" />
<xacro:property name="steering_thickness" value="0.01" />

<!-- Wheel dimensions -->
<xacro:property name="wheel_mass" value="0.2" />
<xacro:property name="wheel_radius" value="0.0775" />
<xacro:property name="wheel_width" value="0.055" />

<!-- -->
<xacro:property name="front_x_reflect" value="1" />
<xacro:property name="rear_x_reflect" value="-1" />

<xacro:property name="left_y_reflect" value="1" />
<xacro:property name="right_y_reflect" value="-1" />

<xacro:property name="front_y_reflect" value="0"/>

<material name="Red">
  <color rgba="1 0 0 1"/>
</material>

<material name="Green">
  <color rgba="0 1 0 1"/>
</material>

<material name="Blue">
  <color rgba="0 0 1 1"/>
</material>

<material name="Yellow">
  <color rgba="1 1 0 1"/>
</material>

<material name="Cyan">
  <color rgba="0 1 1 1"/>
</material>

<material name="Magenta">
  <color rgba="1 0 1 1"/>
</material>

<material name="White">
  <color rgba="1 1 1 1"/>
</material>


<link name="base_footprint">
</link>

<joint name="joint_base_to_footprint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
</joint>

<!-- <link name="base_link">
</link> -->

<link name="base_link">
  <inertial>
    <origin xyz="9.88370881442107e-15 1.585123111746775e-15 0.23509051148364088" rpy="0 0 0"/>
    <mass value="8.427520916605515"/>
    <inertia ixx="0.292265" iyy="0.291616" izz="0.580407" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
  
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://swerve_drive_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      <!-- <mesh filename="/home/knight/swerve_drive_ws/src/swerve_drive_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/> -->
    </geometry> 
    <material name="Red"/>
  </visual>
  <collision>
