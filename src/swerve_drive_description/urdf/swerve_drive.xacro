<joint name="joint_steering_left_front" type="continuous">
  <origin xyz="0.175 0.2 0.225" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="assembly_1_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="joint_steering_right_front" type="continuous">
  <origin xyz="0.175 -0.2 0.225" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="assembly_2_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="joint_steering_left_rear" type="continuous">
  <origin xyz="-0.175 0.2 0.225" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="assembly_3_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="joint_steering_right_rear" type="continuous">
  <origin xyz="-0.175 -0.2 0.225" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="assembly_4_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>




<joint name="joint_wheel_left_front" type="continuous">
  <origin xyz="0.0 -0.06 -0.175" rpy="0 0 0"/>
  <parent link="assembly_1_1"/>
  <child link="wheel_1_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="joint_wheel_right_front" type="continuous">
  <origin xyz="0.0 0.06 -0.175" rpy="0 0 0"/>
  <parent link="assembly_2_1"/>
  <child link="wheel_2_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="joint_wheel_left_rear" type="continuous">
  <origin xyz="0.0 0.06 -0.175" rpy="0 0 0"/>
  <parent link="assembly_3_1"/>
  <child link="wheel_3_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="joint_wheel_right_rear" type="continuous">
  <origin xyz="0.0 -0.06 -0.175" rpy="0 0 0"/>
  <parent link="assembly_4_1"/>
  <child link="wheel_4_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>




    
<link name="laser_frame">
  <inertial> 
    <origin xyz="0.0 -5.654319433712919e-18 0.009999999999999953" rpy="0 0 0"/>
    <mass value ="0.1"/>
    <inertia ixx="4.6e-05" iyy="4.6e-05" izz="8.5e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <geometry>
      <cylinder length="0.04" radius="0.05"/>
    </geometry>
    <material name="Blue"/>
  </visual>
  <collision>
    <geometry>
      <cylinder length="0.04" radius="0.05"/>
    </geometry>
  </collision>
</link>

<link name="imu_sensor">
  <inertial> 
    <origin xyz="0.0 -5.654319433712919e-18 0.0509999999999999953" rpy="0 0 0"/>
    <mass value ="0.1"/>
    <inertia ixx="4.6e-05" iyy="4.6e-05" izz="8.5e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <geometry>
      <cylinder length="0.04" radius="0.05"/>
    </geometry>
    <material name="Red"/>
  </visual>
  <collision>
    <geometry>
      <cylinder length="0.04" radius="0.05"/>
    </geometry>
  </collision>
</link>

<joint name="laser_joint" type="fixed">
    <origin xyz="0.0 0.0 0.275" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_frame"/>  
</joint>

<joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.275" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_sensor"/>  
</joint>




<gazebo reference="laser_frame">
  <sensor type="gpu_lidar" name="lidar_1">
    <update_rate>10.0</update_rate> <!-- Frequency of data publication -->
    <always_on>true</always_on>
    <visualize>true</visualize>
    <topic>/scan</topic> <!-- ROS topic for lidar data -->
    <ray>
      <scan>
        <horizontal>
          <samples>180</samples> <!-- Number of laser beams (e.g., 0.33° resolution for 360°) -->
          <resolution>1.0</resolution> <!-- Angular resolution -->
          <min_angle>0</min_angle> <!-- -180 degrees in radians -->
          <max_angle>6.283</max_angle> <!-- 180 degrees in radians -->
        </horizontal>
        <vertical>
          <samples>1</samples> <!-- No vertical sweep for 2D lidar -->
          <resolution>1.0</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.1</min> <!-- Minimum range in meters -->
        <max>10.0</max> <!-- Maximum range in meters -->
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev> <!-- Simulated noise -->
      </noise>
    </ray>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
    </plugin>
  </sensor>
</gazebo>

 

<ros2_control name="SwerveControl2" type="system">
    <hardware>
        <!-- <plugin>ign_ros2_control/IgnitionSystem</plugin> -->
        <plugin>swerve_drive_hardware/SwerveDriveHardware</plugin>
    </hardware>

    <joint name="joint_steering_left_front">
        <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
        </command_interface>
        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="joint_steering_right_front">
        <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
        </command_interface>
        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        
    </joint>

    <joint name="joint_steering_left_rear">
        <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
        </command_interface>
        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="joint_steering_right_rear">
        <command_interface name="position">
            <param name="min">-100</param>
            <param name="max">100</param>
        </command_interface>
        
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>



    <joint name="joint_wheel_left_front">
        <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
        </command_interface>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wheel_right_front">
        <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
        </command_interface>
        
        <state_interface name="position"/>
        <state_interface name="velocity">
        <param name="initial_value">0.0</param> 
        </state_interface>
    </joint>

    <joint name="joint_wheel_left_rear">
        <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
        </command_interface>

        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>


    <joint name="joint_wheel_right_rear">
        <command_interface name="velocity">
            <param name="min">-2.5</param>
            <param name="max">2.5</param>
        </command_interface>

        <state_interface name="position"/>
        <state_interface name="velocity"/> 
    </joint>

</ros2_control>

<gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(find swerve_drive_description)/config/swerve_controller.yaml</parameters>
    </plugin>
  
</gazebo>

<gazebo reference="imu_sensor">
  <gravity>true</gravity>
  <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>25</update_rate>
      <visualize>true</visualize>
      <topic>/imu</topic>
      <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
      </plugin>
      <pose>0 0 0 0 0 0</pose>
  </sensor>
</gazebo>



<gazebo>
  <plugin
        filename="libignition-gazebo-pose-publisher-system.so"
        name="ignition::gazebo::systems::PosePublisher">
    <publish_link_pose>true</publish_link_pose>
    <publish_sensor_pose>true</publish_sensor_pose>
    <publish_collision_pose>false</publish_collision_pose>
    <publish_visual_pose>false</publish_visual_pose>
    <publish_model_pose>true</publish_model_pose>
    <publish_nested_model_pose>true</publish_nested_model_pose>
    <use_pose_vector_msg>true</use_pose_vector_msg>
    <static_publisher>true</static_publisher>
    <static_update_frequency>-1</static_update_frequency>
  </plugin>
</gazebo>
</robot>
